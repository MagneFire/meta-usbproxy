#!/bin/sh
# usb-proxy appliance launcher — respawned by /etc/inittab.
#
# This stays deliberately simple: it execs usb-proxy so usb-proxy IS the
# inittab-tracked process (exactly one instance, no orphans). usb-proxy waits
# for a device itself (100 ms sysfs poll, no bus traffic) and exits when the
# proxied device leaves the bus, so inittab respawns us and the next instance
# picks up whatever comes back. This mirrors Armbian's systemd "Restart=always"
# model; no supervisor/restart logic here (an earlier background-supervisor
# version orphaned instances and wedged the UDC with "couldn't find an
# available UDC or it's busy").
#
# Why usb-proxy waits and this script does not: the old launcher scanned sysfs
# and, with nothing attached, did `sleep 2; exit 0` for inittab to respawn.
# Measured on hardware that cycle cost ~3 s, so a device that came back sat
# enumerated for 0-3 s before the proxy even started; the Mac saw it 3.8 s
# after the kernel did, versus 1.2 s when the proxy was already waiting (the
# boot case). It also ran the whole wait wound down and paid a shell + sysfs
# scan per cycle. usb-proxy's power policy covers the idle case now: it starts
# wound up, winds down after power_idle_ms of no traffic, and winds up again
# the moment a device is opened.
#
# Status lines go to stdout (serial console under BusyBox init) and the
# logfile; usb-proxy's own output goes to the logfile only.
set -u

CONF_DIR=/etc/usb-proxy
LOG_DIR=/var/volatile/log
LOG="$LOG_DIR/usb-proxy.log"
mkdir -p "$LOG_DIR"

# State across respawns (tmpfs, gone on reboot):
#   STARTED_STAMP  exists once a usb-proxy instance has run since boot.
#                  Absent = first run after boot.
#   DETACH_STAMP   touched on the first launcher run after a proxy exit, i.e.
#                  at (within ms of) the moment the gadget dropped off the Mac.
STARTED_STAMP=/run/usb-proxy.started
DETACH_STAMP=/run/usb-proxy.detached
MIN_OFF_S=1
SETTLE_MS=1000

say() { echo "[usb-proxy-run] $*"; echo "[usb-proxy-run] $*" >> "$LOG"; }

# inittab respawns us immediately after usb-proxy exits, so "launcher start
# with no detach stamp" marks the detach. Kept until the next exec.
[ -e "$DETACH_STAMP" ] || : > "$DETACH_STAMP"

# Need a UDC (gadget controller) to proxy onto.
udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$udc" ]; then
    say "no UDC under /sys/class/udc yet; retrying"
    sleep 2
    exit 0
fi

# Kernel USB quirks for devices the appliance's own host stack is slow to
# enumerate. Applied once, before the first proxy instance.
#
#   22b8:42d1:d  Motorola/Moto 360 (minnow) fastboot bootloader. Its config
#                descriptor names a configuration string (iConfiguration=4)
#                that the bootloader never answers. usb_set_configuration()
#                reads that string while holding the device lock, so the
#                kernel sat in a 5 s control timeout and usb-proxy's open()
#                blocked behind it: measured "device found" -> "opened" of
#                5.0 s for the bootloader vs 1.0 s (the settle) for Android.
#                Quirk letter d = USB_QUIRK_CONFIG_INTF_STRINGS: skip the
#                configuration/interface string reads. The Mac never asks
#                for that string, so direct connections never paid this.
#                Same syntax as the usbcore.quirks= kernel parameter.
USB_QUIRKS="22b8:42d1:d"

settle=0
if [ ! -e "$STARTED_STAMP" ]; then
    if [ -n "$USB_QUIRKS" ] && [ -w /sys/module/usbcore/parameters/quirks ]; then
        echo "$USB_QUIRKS" > /sys/module/usbcore/parameters/quirks
        say "usbcore quirks: $(cat /sys/module/usbcore/parameters/quirks)"
    fi
else
    # Settle debounce, done inside usb-proxy. The watch re-enumerates several
    # times on a cradle attach (measured: a device that lived 2.2 s, then one
    # that lived 0.33 s, then the real one) and once more around each reboot.
    # Proxying a transient one puts the Mac through a pointless
    # enumerate/vanish cycle -- the recorded trigger for macOS keeping a stale
    # device object -- so a newly appeared device must survive a second before
    # the gadget attaches. Not on the first instance after boot: a device
    # already there at boot attaches immediately.
    settle=$SETTLE_MS

    # Minimum gadget-off time. A respawn on the same device (crash, kill -9)
    # re-attaches within milliseconds, which macOS has been seen to miss
    # entirely (MUSB-BULK-OUT.md 7b). Hold D+ low for at least MIN_OFF_S since
    # the detach. Done here, before exec: usb-proxy cannot attach before it
    # has a device anyway, and nothing arrives inside this window that the
    # settle would not have held back.
    now=$(date +%s)
    detached=$(stat -c %Y "$DETACH_STAMP" 2>/dev/null || echo "$now")
    off=$((now - detached))
    [ "$off" -lt "$MIN_OFF_S" ] && sleep $((MIN_OFF_S - off))
fi

cd "$CONF_DIR" || exit 1
: > "$STARTED_STAMP"
rm -f "$DETACH_STAMP"
say "exec usb-proxy on UDC $udc (settle ${settle} ms)"

# exec: replace the shell so usb-proxy is the respawned process. On device
# disconnect it exits and inittab respawns us.
exec /usr/bin/usb-proxy \
    --device "$udc" \
    --driver musb-hdrc \
    --enable_customized_config \
    --auto_remap_endpoints \
    --settle_ms "$settle" >> "$LOG" 2>&1
