#!/bin/sh
# usb-proxy appliance launcher — respawned by /etc/inittab.
#
# This stays deliberately simple: it execs usb-proxy so usb-proxy IS the
# inittab-tracked process (exactly one instance, no orphans). usb-proxy already
# handles device disconnect itself — its libusb hotplug callback fires on
# DEVICE_LEFT and SIGINTs the process — so on unplug it exits and inittab
# respawns us, which re-proxies whatever is attached on replug. This mirrors
# Armbian's systemd "Restart=always" model; no supervisor/restart logic here
# (an earlier background-supervisor version orphaned instances and wedged the
# UDC with "couldn't find an available UDC or it's busy").
#
# Status lines go to stdout (serial console under BusyBox init) and the
# logfile; usb-proxy's own output goes to the logfile only.
set -u

CONF_DIR=/etc/usb-proxy
LOG_DIR=/var/volatile/log
LOG="$LOG_DIR/usb-proxy.log"
mkdir -p "$LOG_DIR"

# State across respawns (tmpfs, gone on reboot):
#   DEVNUM_STAMP  devnum of the device the previous usb-proxy instance proxied.
#                 Absent = first run after boot.
#   DETACH_STAMP  touched on the first launcher run after a proxy exit, i.e.
#                 at (within ms of) the moment the gadget dropped off the Mac.
DEVNUM_STAMP=/run/usb-proxy.devnum
DETACH_STAMP=/run/usb-proxy.detached
MIN_OFF_S=1

say() { echo "[usb-proxy-run] $*"; echo "[usb-proxy-run] $*" >> "$LOG"; }

# inittab respawns us immediately after usb-proxy exits, so "launcher start
# with no detach stamp" marks the detach. Kept until the next exec.
[ -e "$DETACH_STAMP" ] || : > "$DETACH_STAMP"

# Need a UDC (gadget controller) to proxy onto.
udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$udc" ]; then
    say "no UDC under /sys/class/udc yet; retrying"
    sleep 2
    exit 0
fi

# Need a (non-hub) USB device to proxy; otherwise wait and let init respawn us
# (avoids a tight respawn loop when nothing is attached).
have_dev=
for d in /sys/bus/usb/devices/*/idVendor; do
    [ -e "$d" ] || continue
    dev_dir=$(dirname "$d")
    [ "$(cat "$dev_dir/bDeviceClass" 2>/dev/null)" = "09" ] && continue
    have_dev=1
    break
done
if [ -z "$have_dev" ]; then
    say "no USB device attached to proxy yet; waiting"
    # Nothing to proxy means nothing to be fast for. usb-proxy drives the
    # active/idle hook itself, but it never gets to run in this branch, so
    # `power-tune boot` would otherwise leave the board wound up at two cores
    # indefinitely whenever no device is attached — the exact state an idle
    # appliance sits in. Wind down here instead; usb-proxy winds back up the
    # moment it sees traffic.
    #
    # Only on the transition. inittab respawns this script every couple of
    # seconds while nothing is attached, and forking power-tune every time is
    # not free: measured on hardware, this branch running flat out costs 2.7%
    # of a core versus 0.25% quiescent — five times busier doing nothing than
    # the proxy is when actually working.
    if [ -x /usr/bin/power-tune ] &&
       [ "$(cat /sys/devices/system/cpu/cpu1/online 2>/dev/null)" = "1" ]; then
        /usr/bin/power-tune idle
    fi
    sleep 2
    exit 0
fi

# Settle debounce. The watch re-enumerates several times on a cradle attach
# (measured: a device that lived 2.2 s, then one that lived 0.33 s, then the
# real one) and once more around each reboot. Proxying a transient one puts
# the Mac through a pointless enumerate/vanish cycle -- the recorded trigger
# for macOS keeping a stale device object -- so require a newly appeared
# device to survive a second before attaching the gadget. Only on a devnum
# change: a device already there at boot (no stamp) attaches immediately.
devnum=$(cat "$dev_dir/devnum" 2>/dev/null)
last_devnum=$(cat "$DEVNUM_STAMP" 2>/dev/null)
if [ -n "$last_devnum" ] && [ "$devnum" != "$last_devnum" ]; then
    sleep 1
    if [ "$(cat "$dev_dir/devnum" 2>/dev/null)" != "$devnum" ]; then
        say "device $dev_dir (devnum $devnum) vanished during settle; retrying"
        exit 0
    fi
fi

# Minimum gadget-off time. A respawn on the same device (crash, kill -9)
# re-attaches within milliseconds, which macOS has been seen to miss entirely
# (MUSB-BULK-OUT.md 7b). Hold D+ low for at least MIN_OFF_S since the detach.
if [ -n "$last_devnum" ]; then
    now=$(date +%s)
    detached=$(stat -c %Y "$DETACH_STAMP" 2>/dev/null || echo "$now")
    off=$((now - detached))
    [ "$off" -lt "$MIN_OFF_S" ] && sleep $((MIN_OFF_S - off))
fi

cd "$CONF_DIR" || exit 1
echo "$devnum" > "$DEVNUM_STAMP"
rm -f "$DETACH_STAMP"
say "exec usb-proxy on UDC $udc (device $dev_dir devnum $devnum)"

# exec: replace the shell so usb-proxy is the respawned process. On device
# disconnect it exits and inittab respawns us.
exec /usr/bin/usb-proxy \
    --device "$udc" \
    --driver musb-hdrc \
    --enable_customized_config \
    --auto_remap_endpoints >> "$LOG" 2>&1
